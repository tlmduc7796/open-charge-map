@echo off
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ports = @(8000,5173); foreach ($port in $ports) { $owners = Get-NetTCPConnection -State Listen -LocalPort $port -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique; foreach ($owner in $owners) { $p = Get-CimInstance Win32_Process | Where-Object { $_.ProcessId -eq $owner }; if (($port -eq 8000 -and $p.CommandLine -match 'uvicorn backend\.app\.main:app') -or ($port -eq 5173 -and $p.CommandLine -match 'vite')) { Stop-Process -Id $owner -Force; Write-Output ('Stopped demo service on port ' + $port) } } }; exit 0"