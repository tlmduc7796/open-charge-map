# Application
APP_ENV=development
LOG_LEVEL=INFO
DEMO_MODE=true
CORS_ORIGINS=http://127.0.0.1:5173
DATABASE_URL=postgresql+psycopg://smart_ev:smart_ev@127.0.0.1:5433/smart_ev_data
CATALOG_STORAGE=database
PLANNED_ARRIVALS_STORAGE=database

# Paths are resolved from the repository root when relative.
DATA_DIR=data_platform/data
MODEL_ARTIFACT_PATH=ml/artifacts/occupancy_model.joblib
MODEL_PREPROCESSOR_PATH=ml/artifacts/occupancy_preprocessor.joblib
MODEL_META_PATH=ml/artifacts/occupancy_model_meta.json

# Finite cap used only for overloaded/offline station scoring.
WAIT_SCORING_CAP_MIN=120

# Phase 07 routing and fixed recommendation normalization thresholds.
ROUTING_TIMEOUT_S=8
RECOMMEND_MAX_DETOUR_MIN=30
RECOMMEND_MAX_WAIT_MIN=120
RECOMMEND_MAX_CHARGE_MIN=90
RECOMMEND_SOC_RISK_BUFFER=0.20

# Backend-only REST key for Goong Directions, Distance Matrix and Places.
# Put the real value in the repository-root .env. Never prefix this key with VITE_.
GOONG_API_KEY=
