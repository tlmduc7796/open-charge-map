# Application
APP_ENV=development
LOG_LEVEL=INFO
DEMO_MODE=true
CORS_ORIGINS=http://127.0.0.1:5173
# Required when DEMO_MODE=false. The release compose file supplies an internal Redis URL.
REDIS_URL=
REDIS_CONNECT_TIMEOUT_S=2
REDIS_COMMAND_TIMEOUT_S=3
API_RATE_LIMIT_READ_PER_MIN=120
API_RATE_LIMIT_WRITE_PER_MIN=30

# Release storage. Keep memory mode for the local demo; use database mode after
# bootstrapping data_platform and applying migrations through 0016_observation_retention_indexes.
DATABASE_URL=postgresql+psycopg://smart_ev:smart_ev@127.0.0.1:5433/smart_ev_data
DATABASE_CONNECT_TIMEOUT_S=5
DATABASE_STATEMENT_TIMEOUT_MS=15000
CATALOG_STORAGE=memory
PLANNED_ARRIVALS_STORAGE=memory
REALTIME_TELEMETRY_STORAGE=memory
JOURNEY_STORAGE=memory
OCCUPANCY_HISTORY_STORAGE=memory
REALTIME_TELEMETRY_MAX_AGE_S=300
REALTIME_TELEMETRY_MAX_FUTURE_SKEW_S=60
OCCUPANCY_FORECAST_CACHE_TTL_S=300
REALTIME_POLL_INTERVAL_S=15
TELEMETRY_INGEST_API_KEY=
PLANNED_ARRIVAL_ADMIN_API_KEY=
INCIDENT_REVIEW_API_KEY=
JOURNEY_TOKEN_SIGNING_KEY=
RECOMMEND_CANDIDATE_CORRIDOR_M=5000
RECOMMEND_MAX_CANDIDATES=50
REPLAN_DEVIATION_THRESHOLD_M=500
REPLAN_MIN_INTERVAL_MIN=10
JOURNEY_TOKEN_TTL_DAYS=30

# Paths are resolved from the repository root when relative.
DATA_DIR=data
MODEL_ARTIFACT_PATH=ml/artifacts/occupancy_model.joblib
MODEL_PREPROCESSOR_PATH=ml/artifacts/occupancy_preprocessor.joblib
MODEL_META_PATH=ml/artifacts/occupancy_model_meta.json

# Finite cap used only for overloaded/offline station scoring.
WAIT_SCORING_CAP_MIN=120

# Phase 07 routing and fixed recommendation normalization thresholds.
ROUTING_TIMEOUT_S=8
# Development fallback; release requires an operator-managed HTTPS OSRM endpoint.
OSRM_BASE_URL=https://router.project-osrm.org
RECOMMEND_MAX_DETOUR_MIN=30
RECOMMEND_MAX_WAIT_MIN=120
RECOMMEND_MAX_CHARGE_MIN=90
RECOMMEND_SOC_RISK_BUFFER=0.20

# Backend-only REST key for Goong Directions, Distance Matrix and Places.
# Put the real value in the repository-root .env. Never prefix this key with VITE_.
GOONG_API_KEY=
