# Application
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://127.0.0.1:5173
DATABASE_URL=postgresql+psycopg://smart_ev:smart_ev@127.0.0.1:5433/smart_ev_data
CATALOG_STORAGE=database

# Paths are resolved from the repository root when relative.
DATA_DIR=database/fixtures
MODEL_ARTIFACT_PATH=ml/artifacts/occupancy_model.joblib
MODEL_PREPROCESSOR_PATH=ml/artifacts/occupancy_preprocessor.joblib
MODEL_META_PATH=ml/artifacts/occupancy_model_meta.json

# Directory with the six XGBoost boosters model_h{5,10,15,20,25,30}.json written by
# `python -m ml.train_eval`. Without them the backend serves default occupancy values.
MODEL_DIR=ml/model
# Decay time (minutes) with which the T+30 prediction converges to the station profile
# for forecasts beyond 30 minutes.
PROFILE_BLEND_TAU_MIN=30

# Upper bound of the estimated wait. The wait rule itself never exceeds 30 minutes.
WAIT_SCORING_CAP_MIN=120

# Phase 07 routing and fixed recommendation normalization thresholds.
ROUTING_TIMEOUT_S=8
RECOMMEND_MAX_DETOUR_MIN=30
RECOMMEND_MAX_WAIT_MIN=120
RECOMMEND_MAX_CHARGE_MIN=90
RECOMMEND_SOC_RISK_BUFFER=0.20
RECOMMEND_CANDIDATE_CORRIDOR_M=5000
# Occupancy arrives every 5 minutes; a station whose newest bucket is older than this is "unknown".
STATION_STATUS_STALE_AFTER_S=900
AVAILABILITY_GREEN_MIN=2
SEARCH_RATE_LIMIT_PER_MIN=30

# Demo only: when true the backend writes a random number of busy ports per station every 5
# minutes. Leave false when station status comes from the simulator through
# /api/v1/internal/station-occupancy.
DEMO_RANDOM_SIMULATION=false

# Required by /api/v1/internal endpoints. Use a secret value outside local development.
INTERNAL_API_KEY=smart-ev-dev-internal-key

# Backend-only REST key for Goong Directions, Distance Matrix and Places.
# Put the real value in the repository-root .env. Never prefix this key with VITE_.
GOONG_API_KEY=

# Chạy toàn bộ stack bằng `docker compose up --build` (không cần tạo .env).
# Mật khẩu Postgres mặc định chỉ phù hợp chạy local; có thể ghi đè khi cần.
POSTGRES_PASSWORD=smart_ev
RESET_ON_START=0
HISTORY_DAYS=30
POSTGRES_HOST_PORT=5433
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

# Frontend gọi trực tiếp API từ trình duyệt, vì vậy URL phải truy cập được từ host.
VITE_API_BASE_URL=http://127.0.0.1:8000
# Chỉ dùng key maptiles trên frontend; bỏ trống để dùng Leaflet + OpenStreetMap.
VITE_GOONG_MAPTILES_KEY=
