{
  "schema_version": "data-contract-2",
  "purpose": "Canonical source-contract review. Models consume versioned dataset products, never vendor raw files.",
  "deployment_region": "UNRESOLVED",
  "canonical_keys": ["observed_at", "received_at", "station_id", "port_id", "source", "schema_version", "quality_flag", "is_backfilled", "split"],
  "canonical_products": {
    "occupancy_history": {
      "grain": "station snapshot",
      "required_columns": ["observed_at", "received_at", "station_id", "occupied_ports", "available_ports", "offline_ports", "total_ports", "occupancy_ratio", "source", "schema_version", "quality_flag", "is_backfilled"],
      "split_rule": "strictly temporal by observed_at"
    },
    "sessions": {
      "grain": "charging session",
      "required_columns": ["session_id", "station_id", "port_id", "connector_type", "connection_at", "done_charging_at", "disconnect_at", "is_censored", "censoring_at", "source", "schema_version", "quality_flag"],
      "split_rule": "all observations of a session inherit split from disconnect_at"
    },
    "session_telemetry": {
      "grain": "session observation",
      "required_columns": ["session_id", "station_id", "port_id", "observed_at", "received_at", "energy_delivered_kwh", "current_power_kw", "source", "schema_version", "quality_flag", "is_backfilled"],
      "split_rule": "inherits the complete session split"
    },
    "port_status": {
      "grain": "per-port snapshot/event",
      "required_columns": ["observed_at", "received_at", "station_id", "port_id", "connector_type", "state", "event_id", "event_sequence", "source", "schema_version", "quality_flag", "is_backfilled"],
      "split_rule": "strictly temporal by observed_at"
    }
  },
  "target": {
    "name": "occupancy_ratio",
    "availability": "approved_for_pipeline_only",
    "note": "UrbanEV target is suitable for pipeline validation, not Vietnamese production claims."
  },
  "domains": {
    "occupancy": {
      "status": "approved_for_pipeline_only",
      "join_keys": ["entity_id", "timestamp"],
      "features": ["occupancy_ratio", "occupied_ports", "total_ports"],
      "note": "Must come from append-only validated station telemetry in production."
    },
    "temporal_calendar": {
      "status": "candidate",
      "join_keys": ["timestamp"],
      "features": ["hour_sin", "hour_cos", "dow_sin", "dow_cos", "is_weekend", "is_public_holiday"],
      "note": "Region-specific holiday calendar; German and Vietnam calendars must never be mixed."
    },
    "weather": {
      "status": "candidate",
      "join_keys": ["timestamp", "station_region"],
      "features": ["temperature_2m", "relative_humidity_2m", "precipitation", "wind_speed_10m", "is_raining"],
      "note": "Needs station-local historical and real-time source, freshness policy and missing-value strategy."
    },
    "poi_spatial": {
      "status": "candidate",
      "join_keys": ["entity_id"],
      "features": ["location_type", "poi_count_500m", "competitor_count_2km", "road_class"],
      "note": "Static station context; version whenever OSM/provider snapshot changes."
    },
    "traffic": {
      "status": "candidate",
      "join_keys": ["entity_id", "timestamp"],
      "features": ["congestion_level", "mean_speed_kmh"],
      "note": "Needs licensed/live source and leakage audit. Do not replace it with an undocumented synthetic proxy."
    },
    "charging_sessions": {
      "status": "candidate",
      "join_keys": ["entity_id", "timestamp"],
      "features": ["arrival_rate_per_hour", "session_duration_min", "soc_on_arrival", "vehicle_segment", "session_id", "port_id", "connector_type", "session_elapsed_min", "energy_delivered_kwh", "current_power_kw", "target_soc", "done_charging_at", "disconnect_at", "remaining_port_release_min"],
      "note": "Sensitive operational data; define consent, retention and aggregation before use. Per-session fields enable DES and residual-duration modelling only after telemetry contracts are approved."
    }
  },
  "dataset_products": {
    "occupancy_supervised": {
      "builders": ["prepare_occupancy_history.py", "build_feature_dataset.py"],
      "models": ["xgboost_baseline", "lstm_markov", "transformer"],
      "label": "occupancy_ratio at +5...+60 minutes"
    },
    "rdm_session_observations": {
      "builders": ["prepare_acn_data.py", "build_rdm_dataset.py"],
      "models": ["residual_duration"],
      "label": "disconnect_at - observed_at"
    },
    "connector_markov_states": {
      "builders": ["build_markov_dataset.py"],
      "models": ["markov_wait"],
      "label": "next connector-aware availability state"
    }
  },
  "model_profiles": {
    "xgboost_baseline": {
      "enabled": true,
      "sequence_features": ["occupancy_ratio"],
      "context_features": [],
      "serving_status": "backend_supported"
    },
    "lstm_markov": {
      "enabled": false,
      "sequence_features": ["occupancy_ratio"],
      "context_features": [],
      "serving_status": "experimental"
    },
    "markov_wait": {
      "enabled": false,
      "sequence_features": ["occupied_ports", "total_ports"],
      "context_features": ["hour_sin", "hour_cos", "dow_sin", "dow_cos", "is_weekend", "is_public_holiday"],
      "serving_status": "experimental_probability_layer"
    },
    "transformer": {
      "enabled": false,
      "sequence_features": ["occupancy_ratio", "temperature_2m", "precipitation", "congestion_level"],
      "context_features": ["hour_sin", "hour_cos", "dow_sin", "dow_cos", "is_weekend", "location_type", "poi_count_500m"],
      "serving_status": "experimental"
    },
    "foundation_finetune": {
      "enabled": false,
      "sequence_features": ["occupancy_ratio"],
      "context_features": [],
      "serving_status": "research_only"
    },
    "residual_duration": {
      "enabled": false,
      "sequence_features": ["session_elapsed_min", "energy_delivered_kwh", "current_power_kw", "soc_on_arrival", "target_soc"],
      "context_features": ["vehicle_segment", "connector_type"],
      "serving_status": "telemetry_gated"
    }
  },
  "handoff_checklist": [
    "Replace UNRESOLVED deployment_region with the actual station region.",
    "For every candidate domain, approve/remove fields, source, granularity, timezone, freshness and missing-value handling.",
    "Build a versioned enriched dataset and verify that every selected field is available at inference time.",
    "For DES/RDM, define port/session lifecycle events, connector compatibility, data freshness, and disconnect_at as the ground-truth port-release timestamp; done_charging_at is not port release.",
    "Change only the relevant model profile enabled flag after data and privacy review.",
    "Run temporal backtest, calibration, capacity and fairness checks before production promotion."
  ]
}
