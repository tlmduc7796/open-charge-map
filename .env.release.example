# Copy to .env.release and replace every secret before starting the release stack.
# Use URL-safe hex values for database/Redis passwords, for example: openssl rand -hex 32
APP_ENV=production
DEMO_MODE=false
POSTGRES_PASSWORD=
# Optional host port for PostgreSQL; defaults to 5433.
POSTGRES_HOST_PORT=5433
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT_S=2
REDIS_COMMAND_TIMEOUT_S=3
DATABASE_CONNECT_TIMEOUT_S=5
DATABASE_STATEMENT_TIMEOUT_MS=15000
TELEMETRY_INGEST_API_KEY=
PLANNED_ARRIVAL_ADMIN_API_KEY=
INCIDENT_REVIEW_API_KEY=
JOURNEY_TOKEN_SIGNING_KEY=
# OIDC client must use Authorization Code + PKCE and allow https://your-host/auth/callback.
OIDC_ISSUER=https://identity.example.com/
OIDC_AUDIENCE=smart-ev-api
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
OIDC_CLIENT_ID=
OIDC_SCOPE=openid profile email offline_access
# File containing the HTTPS notification webhook URL (one line, outside source control).
ALERTMANAGER_WEBHOOK_URL_FILE=.secrets/alertmanager-webhook-url
# File containing a randomly generated Grafana admin password (32+ characters).
GRAFANA_ADMIN_PASSWORD_FILE=.secrets/grafana-admin-password
# Grafana dashboard is bound to loopback by default; access it through a secure tunnel.
GRAFANA_HOST_PORT=3000
# Required provider key for release geocoding and primary directions.
GOONG_API_KEY=
VITE_GOONG_MAPTILES_KEY=
# Replace with the operator-managed HTTPS OSRM endpoint; the public demo service is rejected.
OSRM_BASE_URL=https://routing.example.net
# Use the public HTTPS browser origin(s); HTTP is accepted only for loopback smoke tests.
CORS_ORIGINS=http://localhost:8080
# Bind the plaintext app port to loopback; the host TLS reverse proxy is the public entry point.
RELEASE_WEB_HOST_BIND=127.0.0.1
# Keep this private subnet clear of host/VPN networks; preflight requires at least /28.
RELEASE_DOCKER_SUBNET=172.31.250.0/24
RELEASE_DOCKER_IP_RANGE=172.31.250.128/25
RELEASE_WEB_PROXY_IP=172.31.250.2
# Must match RELEASE_WEB_PROXY_IP exactly; only Nginx may forward client headers.
FORWARDED_ALLOW_IPS=172.31.250.2
API_RATE_LIMIT_READ_PER_MIN=120
API_RATE_LIMIT_WRITE_PER_MIN=30
OCCUPANCY_FORECAST_CACHE_TTL_S=300
RECOMMEND_CANDIDATE_CORRIDOR_M=5000
RECOMMEND_MAX_CANDIDATES=50
REALTIME_TELEMETRY_MAX_FUTURE_SKEW_S=60
# Set an operator-approved maximum age for source catalog timestamps (seconds).
CATALOG_SOURCE_MAX_AGE_S=
# Set only after the deployment's observation retention period is approved (1-36500 days).
OBSERVATION_RETENTION_DAYS=
