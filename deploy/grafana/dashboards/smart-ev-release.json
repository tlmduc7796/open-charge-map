      "id": 2,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "100 * sum(rate(smart_ev_http_responses_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(smart_ev_http_responses_total[5m])), 0.1)", "legendFormat": "5xx", "refId": "A"}],
      "title": "API 5xx response rate",
      "type": "timeseries"
