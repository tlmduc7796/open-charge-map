      "id": 1,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "sum(rate(smart_ev_http_responses_total[5m]))", "legendFormat": "all requests", "refId": "A"}],
      "title": "API request rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "smart-ev-prometheus"},
