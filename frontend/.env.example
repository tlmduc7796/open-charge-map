# Public frontend configuration. Copy to frontend/.env.local for local development.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_DEMO_MODE=true

# Goong Maptiles Key only. Do not put the backend GOONG_API_KEY here.
VITE_GOONG_MAPTILES_KEY=

# For release builds, set these to the public OIDC client registered for the
# exact callback URL https://<deployment-host>/auth/callback.
# Keep VITE_DEMO_MODE=true for local demo use; release Compose sets it to false.
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_SCOPE=openid profile email offline_access
